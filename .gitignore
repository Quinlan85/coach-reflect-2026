# Build output and dependencies. Neither was ignored before because neither had
# ever been installed in this working copy; running the build creates both.
/node_modules
/.next
/out

# Generated by `next build` when it detects TypeScript. Not tracked previously,
# so it stays untracked — the build recreates it.
/next-env.d.ts
/tsconfig.json
/package-lock.json

.DS_Store
*.log
.env*.local
